CAPI=2:
# Keep in sync with Bender.yml
# FuseSoC CAPI2 manifest for the HDL template.

name: "acme:templates:hdl_template:0.1.0"

filesets:
  rtl_vhdl:
    description: "VHDL RTL sources"
    files:
      - src/vhdl/<<NAME>>_pkg.vhd
      - src/vhdl/<<NAME>>_core.vhd
      - src/vhdl/<<NAME>>_top.vhd
    file_type: vhdlSource-2008

  gen_vhdl:
    description: "Generated VHDL register files (run make regs first)"
    files:
      - out/regs/vhdl/<<NAME>>_regs_pkg.vhd
      - out/regs/vhdl/<<NAME>>_register_record_pkg.vhd
      - out/regs/vhdl/<<NAME>>_register_file_axi_lite.vhd
    file_type: vhdlSource-2008

  rtl_sv:
    description: "SystemVerilog RTL sources"
    files:
      - src/sv/<<NAME>>_pkg.sv
      - src/sv/<<NAME>>_core.sv
      - src/sv/<<NAME>>_top.sv
    file_type: systemVerilogSource

  gen_sv:
    description: "Generated SystemVerilog register files (run make regs first)"
    files:
      - out/regs/sv/<<NAME>>_regs_addr_pkg.sv
      - out/regs/sv/<<NAME>>_register_file_axi_lite_pkg.sv
      - out/regs/sv/<<NAME>>_register_file_axi_lite.sv
    file_type: systemVerilogSource

  tb_vhdl:
    description: "VHDL testbench (VUnit)"
    files:
      - tb/vunit/vhdl/<<NAME>>_tb.vhd
    file_type: vhdlSource-2008

targets:
  default: &default
    filesets:
      - rtl_vhdl
      - gen_vhdl
    toplevel: <<NAME>>_top

  sim:
    <<: *default
    filesets_append:
      - tb_vhdl
    default_tool: ghdl
    tools:
      ghdl:
        analyze_options: [--std=08]
        run_options: [--wave=waves/<<NAME>>_top.fst]

  sim_sv:
    filesets:
      - rtl_sv
      - gen_sv
    toplevel: <<NAME>>_top
    default_tool: icarus

  synth:
    <<: *default
    default_tool: yosys
