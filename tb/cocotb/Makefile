# cocotb simulation Makefile for <<NAME>>_top.
#
# Called by the top-level Makefile via: make -C tb/cocotb SIM= TOPLEVEL_HDL=
#
# Supported combinations:
#   SIM=ghdl       TOPLEVEL_HDL=vhdl  — VHDL via GHDL + VPI
#   SIM=verilator  TOPLEVEL_HDL=sv    — SystemVerilog via Verilator + VPI
#   SIM=icarus     TOPLEVEL_HDL=sv    — SystemVerilog via Icarus Verilog + VPI
#
# tb/cocotb/test_NAME.py drives the design through its real AXI-Lite register
# interface via cocotbext-axi, so the AXI-Lite register block (generated by
# `make regs`) and hdl-modules (VHDL only) ARE involved here.
#
# VHDL note: <<NAME>>_top's AXI-Lite port is typed with hdl-modules' record
# types (axi_lite_m2s_t/axi_lite_s2m_t). GHDL's VPI backend cannot expose
# VHDL record-typed ports to cocotb at all (verified empirically -- such a
# port doesn't even appear in `dir(dut)`), so cocotbext-axi's
# AxiLiteBus.from_prefix(dut, "s_axi") cannot see it directly. TOPLEVEL for
# SIM=ghdl is therefore tb/cocotb/vhdl/<<NAME>>_cocotb_top.vhd, a thin
# cocotb-only wrapper that flattens the record into individual s_axi_*
# signals (identical in name/width to <<NAME>>_top.sv's native flat ports)
# around an unmodified instance of <<NAME>>_top. This wrapper is not part of
# the project's synthesizable RTL and is not referenced anywhere else.

COCOTB_MAKEFILES := $(shell cocotb-config --makefiles)

# ── Configurable variables (passed in from top-level Makefile) ────────────────
SIM          ?= ghdl
TOPLEVEL_HDL ?= vhdl
MODULE       ?= test_NAME
REPO_ROOT    := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../..)
BENDER       ?= bender

# ── Bender-generated file lists (generated register files; evaluated lazily,
# from REPO_ROOT since Bender.yml lives there, not in tb/cocotb) ─────────────
VHDL_GEN = $(shell cd $(REPO_ROOT) && $(BENDER) script flist -t gen_vhdl --no-default-target 2>/dev/null)
SV_GEN   = $(shell cd $(REPO_ROOT) && $(BENDER) script flist -t gen_sv   --no-default-target 2>/dev/null)

# ── hdl-modules VHDL packages required by the generated register file ─────────
# Only axi_lite_pkg (types) and register_file_pkg + axi_lite_register_file
# (the generic register-file entity the generated <<NAME>>_register_file_axi_lite
# instantiates) are needed. Unlike tb/vunit/run.py, no BFM/common/math
# libraries are needed here: cocotb doesn't use hdl-modules' axi_lite_master
# BFM entity at all -- cocotbext-axi drives the DUT's own ports directly from
# Python, and axi_lite_register_file.vhd's own dependencies stop at
# axi_lite_pkg + its own register_file_pkg (verified by reading its use
# clauses -- no common/math references).
HDL_MODULES = $(shell cd $(REPO_ROOT) && $(BENDER) path hdl_modules 2>/dev/null)

# ── Compatibility guard ────────────────────────────────────────────────────────
ifeq ($(TOPLEVEL_HDL),vhdl)
    ifeq ($(filter ghdl,$(SIM)),)
        $(error TOPLEVEL_HDL=vhdl requires SIM=ghdl, got SIM=$(SIM))
    endif
    TOPLEVEL_LANG   := vhdl
    TOPLEVEL        := <<NAME>>_cocotb_top

    VHDL_SOURCES_axi_lite      := $(HDL_MODULES)/modules/axi_lite/src/axi_lite_pkg.vhd
    VHDL_SOURCES_register_file := \
      $(HDL_MODULES)/modules/register_file/src/register_file_pkg.vhd \
      $(HDL_MODULES)/modules/register_file/src/axi_lite_register_file.vhd

    VHDL_SOURCES    := \
      $(REPO_ROOT)/src/vhdl/<<NAME>>_pkg.vhd \
      $(VHDL_GEN) \
      $(REPO_ROOT)/src/vhdl/<<NAME>>_core.vhd \
      $(REPO_ROOT)/src/vhdl/<<NAME>>_top.vhd \
      $(REPO_ROOT)/tb/cocotb/vhdl/<<NAME>>_cocotb_top.vhd
    VERILOG_SOURCES :=
    COMPILE_ARGS    += --std=08
else ifeq ($(TOPLEVEL_HDL),sv)
    ifeq ($(filter verilator icarus,$(SIM)),)
        $(error TOPLEVEL_HDL=sv requires SIM=verilator or SIM=icarus, got SIM=$(SIM))
    endif
    TOPLEVEL_LANG   := verilog
    TOPLEVEL        := <<NAME>>_top

    VERILOG_SOURCES := \
      $(REPO_ROOT)/src/sv/<<NAME>>_pkg.sv \
      $(SV_GEN) \
      $(REPO_ROOT)/src/sv/<<NAME>>_core.sv \
      $(REPO_ROOT)/src/sv/<<NAME>>_top.sv
    VHDL_SOURCES    :=
    VERILOG_INCLUDE_DIRS := $(REPO_ROOT)/src/sv
else
    $(error Unknown TOPLEVEL_HDL=$(TOPLEVEL_HDL). Valid: vhdl | sv)
endif

# ── Simulator-specific flags ──────────────────────────────────────────────────
ifeq ($(SIM),ghdl)
    SIM_ARGS += --wave=$(REPO_ROOT)/waves/$(TOPLEVEL).fst
endif

ifeq ($(SIM),verilator)
    VERILATOR_TRACE     := 1
    EXTRA_ARGS          += --trace
    # Matches lint-sv/sim-native's -Wno-fatal: the generated register file's
    # actual address/data widths are narrower than <<NAME>>_top.sv's fixed
    # 8-bit/32-bit AXI-Lite port declarations for this small register map,
    # producing benign WIDTHTRUNC/WIDTHEXPAND warnings on the truncating
    # connections. Non-fatal elsewhere in the project; matched here so
    # compilation doesn't stop on them.
    EXTRA_ARGS          += -Wno-fatal
endif

# cocotb test file lives alongside this Makefile
export COCOTB_TEST_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
PYTHONPATH := $(COCOTB_TEST_DIR):$(PYTHONPATH)
export PYTHONPATH

include $(COCOTB_MAKEFILES)/Makefile.sim
