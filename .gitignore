# =============================================================================
# HDL Template — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── HDL dependency manager outputs ────────────────────────────────────────────
# External repos are fetched into deps/ via `bender vendor init`
deps/

# ── Build outputs ─────────────────────────────────────────────────────────────
# All tool outputs (regs, synth, impl, sim, docs) are written under out/.
out/*
!out/.gitkeep
filelist.f
# Legacy paths (pre-out/ layout) — kept so leftover directories stay hidden
gen/
sim_build/
synth/output/
synth/workdir/
waves/
*.fst
*.vcd
*.ghw
*.vvp

# ── Sphinx auto-generated RST (regenerated by `make html`) ───────────────────
# Keep hand-editable shells (entity.rst, etc.) but ignore always-regenerated:
docs/hierarchy.json
docs/hierarchy.dot
docs/hierarchy.rst
docs/overview.rst
docs/registers.rst
docs/_static/registers/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor artefacts ──────────────────────────────────────────────────────────
.vscode/settings.json
vhdl_ls.toml
verible.filelist
*.swp
*.swo
*~

# ── Bender ────────────────────────────────────────────────────────────────────
# Bender.lock IS committed (for reproducible dependency resolution).
# .bender/ local cache directory is NOT committed.
.bender/

# ── Keep placeholder .gitkeep files to preserve empty tracked directories ─────
!out/.gitkeep
!deps/.gitkeep
