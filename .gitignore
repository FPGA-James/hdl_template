# =============================================================================
# HDL Template — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── HDL dependency manager outputs ────────────────────────────────────────────
# External repos are fetched into deps/ via `bender vendor init`
deps/

# ── Generated register files ──────────────────────────────────────────────────
# Produced by `make regs` from regs/*.toml — never commit generated code
gen/

# ── Synthesis artefacts ───────────────────────────────────────────────────────
synth/output/

# ── Simulation artefacts ──────────────────────────────────────────────────────
waves/
sim_build/
filelist.f
*.fst
*.vcd
*.ghw
*.vvp

# ── Documentation build ───────────────────────────────────────────────────────
docs/_build/

# ── Sphinx auto-generated RST (regenerated by `make html`) ───────────────────
# Keep hand-editable shells (entity.rst, etc.) but ignore always-regenerated:
docs/hierarchy.json
docs/hierarchy.dot
docs/hierarchy.rst
docs/overview.rst
docs/registers.rst
docs/_static/registers/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor artefacts ──────────────────────────────────────────────────────────
.vscode/settings.json
*.swp
*.swo
*~

# ── Bender ────────────────────────────────────────────────────────────────────
# Bender.lock IS committed (for reproducible dependency resolution).
# .bender/ local cache directory is NOT committed.
.bender/

# ── Keep placeholder .gitkeep files to preserve empty tracked directories ─────
!gen/.gitkeep
!synth/output/.gitkeep
!waves/.gitkeep
!deps/.gitkeep
